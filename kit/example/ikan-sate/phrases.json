 "phrases": [
  {
   "text": "Bagaimana reaksi ikan kalau dikasih sate ayam?",
   "s": 0.0,
   "e": 2.722
  },
  {
   "text": "Kita tes.",
   "s": 3.281,
   "e": 3.84
  },
  {
   "text": "Satu tusuk sate ayam,",
   "s": 4.167,
   "e": 5.362
  },
  {
   "text": "masuk ke kolam.",
   "s": 5.617,
   "e": 6.361
  },
  {
   "text": "Ikan pemakan daging,",
   "s": 7.005,
   "e": 8.237
  },
  {
   "text": "seperti lele dan cichlid,",
   "s": 8.486,
   "e": 9.874
  },
  {
   "text": "langsung curiga\u2026 lalu menyerbu.",
   "s": 10.238,
   "e": 12.403
  },
  {
   "text": "Memang,",
   "s": 12.88,
   "e": 13.282
  },
  {
   "text": "beberapa ikan bisa makan daging ayam matang polos,",
   "s": 13.677,
   "e": 16.468
  },
  {
   "text": "dalam jumlah kecil.",
   "s": 16.846,
   "e": 17.876
  },
  {
   "text": "Tapi ini sate.",
   "s": 18.738,
   "e": 19.61
  },
  {
   "text": "Ada bumbu kacang,",
   "s": 20.074,
   "e": 21.107
  },
  {
   "text": "garam,",
   "s": 21.293,
   "e": 21.808
  },
  {
   "text": "kecap,",
   "s": 22.022,
   "e": 22.365
  },
  {
   "text": "dan minyak.",
   "s": 22.542,
   "e": 23.033
  },
  {
   "text": "Para pemelihara ikan mengingatkan,",
   "s": 23.52,
   "e": 25.266
  },
  {
   "text": "bumbu itu tidak baik untuk ikan,",
   "s": 25.468,
   "e": 27.186
  },
  {
   "text": "dan minyaknya mengotori air kolam.",
   "s": 27.444,
   "e": 29.326
  },
  {
   "text": "Jadi,",
   "s": 29.977,
   "e": 30.406
  },
  {
   "text": "si ikan menang di lidah,",
   "s": 30.827,
   "e": 32.078
  },
  {
   "text": "tapi kalah di kolam.",
   "s": 32.486,
   "e": 33.462
  },
  {
   "text": "Jangan coba di rumah.",
   "s": 34.234,
   "e": 35.245
  },
  {
   "text": "Sate itu untuk kamu,",
   "s": 35.676,
   "e": 36.874
  },
  {
   "text": "bukan untuk ikan.",
   "s": 37.139,
   "e": 38.124
  }
 ]
