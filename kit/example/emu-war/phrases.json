 "phrases": [
  {
   "text": "Australia pernah mengirim tentara bersenapan mesin untuk melawan burung.",
   "s": 0.164,
   "e": 3.726
  },
  {
   "text": "Burungnya yang menang.",
   "s": 4.126,
   "e": 5.114
  },
  {
   "text": "Tahun 1932,",
   "s": 5.689,
   "e": 7.686
  },
  {
   "text": "dua puluh ribu emu merusak ladang gandum di Australia Barat.",
   "s": 8.095,
   "e": 11.243
  },
  {
   "text": "Maka tentara datang membawa dua senapan mesin dan sepuluh ribu peluru.",
   "s": 11.806,
   "e": 15.686
  },
  {
   "text": "Tapi emu nggak mau berbaris.",
   "s": 16.129,
   "e": 17.449
  },
  {
   "text": "Mereka pecah jadi kelompok kecil dan lari ke segala arah.",
   "s": 17.894,
   "e": 20.722
  },
  {
   "text": "Menurut hitungan mayornya sendiri,",
   "s": 21.369,
   "e": 22.978
  },
  {
   "text": "satu emu butuh sepuluh peluru.",
   "s": 23.317,
   "e": 25.065
  },
  {
   "text": "Seminggu kemudian,",
   "s": 25.674,
   "e": 26.695
  },
  {
   "text": "pemerintah menarik pasukannya.",
   "s": 26.908,
   "e": 28.464
  },
  {
   "text": "Belakangan,",
   "s": 28.987,
   "e": 29.575
  },
  {
   "text": "petani dengan senapan biasa dan hadiah kecil berhasil melakukan apa yang tentara nggak bisa.",
   "s": 29.988,
   "e": 35.261
  },
  {
   "text": "Tentara pulang.",
   "s": 35.812,
   "e": 36.5
  },
  {
   "text": "Emu-nya tetap tinggal.",
